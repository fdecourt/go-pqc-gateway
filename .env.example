# ==============================================================================
# CONFIGURATION DU MICRO-SERVICE DE CHIFFREMENT POST-QUANTIQUE
# ==============================================================================

# --- Déploiement & Conteneur Docker ---
IMAGE_NAME=pq-crypto-service
IMAGE_TAG=0.0.1
CONTAINER_NAME=pq-crypto-microservice
RESTART_POLICY=unless-stopped
NETWORK_NAME=pq-internal-net

# --- Ports & Adresses Réseau ---
# Adresse IP hôte à laquelle Docker lie le port publié (ex: 127.0.0.1 pour isolation locale stricte)
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8085
# Adresse IP d'écoute interne du processus dans le conteneur (0.0.0.0 pour réseau bridge Docker)
LISTEN_ADDRESS=0.0.0.0
CONTAINER_PORT=8080

# --- Mode d'Exécution & Performances ---
ENVIRONMENT=production
ALGORITHM=ML-KEM-1024
MOCK_MODE=false
ALLOW_LEGACY_ENVELOPES=false
TRUST_PROXY=false
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=60
MAX_PAYLOAD_BYTES=10485760
ACCESS_LOG=false
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=100

# --- Observabilité ---
# Format de journalisation structurée : json (défaut, recommandé en production) ou text
LOG_FORMAT=json
# Niveau de journalisation : debug, info (défaut), warn, error
LOG_LEVEL=info
# Expose /metrics au format texte Prometheus (défaut: true).
# À restreindre au réseau de supervision : l'endpoint n'est pas authentifié.
METRICS_ENABLED=true

# --- Transport IPC Unix Domain Socket (Optionnel) ---
# Laissez vide pour n'utiliser que le réseau TCP classique
SOCKET_PATH=
SOCKET_MODE=0660
SOCKET_GID=-1
# Mettre à true pour couper l'écoute TCP et basculer sur communication IPC Unix exclusive
DISABLE_TCP=false

# --- Sécurité & Durcissement Conteneur ---
NO_NEW_PRIVILEGES=true
READ_ONLY_ROOTFS=true
TMPFS_MOUNT=/tmp:rw,noexec,nosuid,size=32m

# --- Sondes de Santé Docker (Healthcheck) ---
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=3s

# --- Limites de Ressources (Docker Deploy) ---
CPU_LIMIT=1.5
MEM_LIMIT=256M
CPU_RESERVATION=0.2
MEM_RESERVATION=64M

# ==============================================================================
# INTÉGRATION INFISICAL (STOCKAGE EN RAM, SYNCHRONISATION SECRETS)
# ==============================================================================
# Activer à true dès que votre instance Infisical (Docker ou SaaS) sera en ligne
INFISICAL_ENABLED=false

# URL de l'instance Infisical
INFISICAL_URL=http://infisical:8080

# Authentification Universal Auth (Machine Identity)
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Projet & Environnement cible dans Infisical
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod

# Noms des secrets stockés dans Infisical (Bundle atomique recommandé)
INFISICAL_SECRET_BUNDLE_NAME=PQ_KEM_KEYPAIR
INFISICAL_SECRET_PUBKEY_NAME=PQ_KEM_PUBLIC_KEY
INFISICAL_SECRET_PRIVKEY_NAME=PQ_KEM_PRIVATE_KEY
