# ==============================================================================
# CONFIGURATION DU MICRO-SERVICE DE CHIFFREMENT POST-QUANTIQUE
# ==============================================================================

# --- Déploiement & Conteneur Docker ---
IMAGE_NAME=pq-crypto-service
IMAGE_TAG=0.3.0
CONTAINER_NAME=pq-crypto-microservice
RESTART_POLICY=unless-stopped
NETWORK_NAME=pq-internal-net

# --- Ports & Adresses Réseau ---
# Adresse IP hôte à laquelle Docker lie le port publié (ex: 127.0.0.1 pour isolation locale stricte)
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8085
# Adresse IP d'écoute interne du processus dans le conteneur (0.0.0.0 pour réseau bridge Docker).
# Hors conteneur, le binaire écoute par défaut sur 127.0.0.1.
LISTEN_ADDRESS=0.0.0.0
CONTAINER_PORT=8080

# --- Sécurité du transport TCP ---
# En production, une écoute TCP hors loopback sans TLS est REFUSÉE au démarrage.
# TLS : certificat et clé serveur au format PEM (monter les fichiers en lecture seule).
TLS_CERT_FILE=
TLS_KEY_FILE=
# mTLS : autorités des certificats clients. Un certificat client vérifié est alors exigé
# sur toutes les routes sauf /health.
TLS_CLIENT_CA_FILE=
# Dernier recours, réseau privé de confiance uniquement : autorise le HTTP en clair hors loopback.
ALLOW_INSECURE_TCP=false

# --- Mode d'Exécution & Performances ---
ENVIRONMENT=production
ALGORITHM=ML-KEM-1024
MOCK_MODE=false
# Proxys (CIDR, virgules) dont X-Forwarded-For est cru pour identifier le client. Vide : jamais.
TRUSTED_PROXIES=
# Version TLS minimale de l'écouteur TCP (1.3 par défaut ; 1.2 pour d'anciens clients)
TLS_MIN_VERSION=1.3
# mTLS : noms (CN, SAN DNS ou URI, virgules) des certificats clients admis. Vide : tout certificat de la CA.
TLS_CLIENT_ALLOWED_NAMES=
# Jetons porteurs admis, « nom:secret » séparés par des virgules (secret ≥ 32 octets), ou AUTH_TOKENS_FILE.
# Vide : aucun jeton exigé (s'appuyer alors sur mTLS, le socket Unix ou le réseau).
AUTH_TOKENS=
# Lie chaque enveloppe à l'identité du client (jeton, certificat ou UID) : un client ne peut pas
# rouvrir l'enveloppe d'un autre. Exige une source d'identité.
BIND_CLIENT_IDENTITY=false
# Journal d'audit : une ligne par opération cryptographique (client, kid, issue), jamais de donnée.
AUDIT_LOG=true
# Connexions simultanées admises par écouteur (0 = illimité)
MAX_CONNECTIONS=1024
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=10
IDLE_TIMEOUT_SECONDS=60
# Garde-fous mémoire : MAX_CONCURRENT_REQUESTS × 4 copies × MAX_PAYLOAD_BYTES < MEM_LIMIT
# (/decrypt accepte 1,5 × MAX_PAYLOAD_BYTES + 64 Kio pour que tout chiffré produit reste déchiffrable)
MAX_PAYLOAD_BYTES=10485760
MAX_CONCURRENT_REQUESTS=16
# Plafond mémoire visé par le GC Go : 85 % de la limite du conteneur si non défini
# GOMEMLIMIT=870MiB
ACCESS_LOG=false
# Limitation de débit par IP (0 = désactivée)
RATE_LIMIT_RPS=500
RATE_LIMIT_BURST=1000

# --- Observabilité ---
# Format de journalisation structurée : json (défaut, recommandé en production) ou text
LOG_FORMAT=json
# Niveau de journalisation : debug, info (défaut), warn, error
LOG_LEVEL=info
# Expose /metrics au format texte Prometheus (défaut: true).
# À restreindre au réseau de supervision : l'endpoint n'est pas authentifié.
METRICS_ENABLED=true

# --- Transport IPC Unix Domain Socket (Optionnel) ---
# Laissez vide pour n'utiliser que le réseau TCP classique
SOCKET_PATH=
SOCKET_MODE=0660
SOCKET_GID=-1
# UID des processus admis sur le socket Unix (SO_PEERCRED, Linux) ; vide : permissions du fichier seules
SOCKET_ALLOWED_UIDS=
# Mettre à true pour couper l'écoute TCP et basculer sur communication IPC Unix exclusive
DISABLE_TCP=false

# --- Sécurité & Durcissement Conteneur ---
NO_NEW_PRIVILEGES=true
READ_ONLY_ROOTFS=true
TMPFS_MOUNT=/tmp:rw,noexec,nosuid,size=32m

# --- Sondes de Santé Docker (Healthcheck) ---
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=3s

# --- Limites de Ressources (Docker Deploy) ---
CPU_LIMIT=1.5
MEM_LIMIT=1G
CPU_RESERVATION=0.2
MEM_RESERVATION=64M

# ==============================================================================
# INTÉGRATION INFISICAL (STOCKAGE EN RAM, SYNCHRONISATION SECRETS)
# ==============================================================================
# Activer à true dès que votre instance Infisical (Docker ou SaaS) sera en ligne
INFISICAL_ENABLED=false

# URL de l'instance Infisical
INFISICAL_URL=https://infisical.example.com

# Authentification Universal Auth (Machine Identity)
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# CA (PEM) de l'instance Infisical si elle n'est pas signée par une autorité du système
INFISICAL_CA_FILE=

# Projet & Environnement cible dans Infisical
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod

# Noms des secrets stockés dans Infisical (Bundle atomique recommandé)
INFISICAL_SECRET_BUNDLE_NAME=PQ_KEM_KEYPAIR
# Ancien format scindé (non lu) : sa présence sans bundle bloque le démarrage au lieu de régénérer
INFISICAL_SECRET_PUBKEY_NAME=PQ_KEM_PUBLIC_KEY
INFISICAL_SECRET_PRIVKEY_NAME=PQ_KEM_PRIVATE_KEY
